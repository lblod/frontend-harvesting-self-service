{{page-title "Dashboard"}}

<div class="au-u-padding">
  <div class="au-u-margin-bottom">
    <AuHeading @level="1" @skin="1">Harvest Dashboard</AuHeading>
  </div>

  {{#if this.loadData.isRunning}}
    <AuAlert @title="Loading data…" @skin="info" @icon="info-circle">
      <p>Querying harvest statistics, this may take a moment.</p>
    </AuAlert>
  {{else if this.loadData.last.error}}
    <AuAlert @title="Failed to load data" @skin="error" @icon="cross">
      <p>{{this.loadData.last.error.message}}</p>
    </AuAlert>
  {{else}}
    <div class="au-u-margin-bottom">
      <AuCard as |c|>
        <c.header>
          <AuHeading @level="2" @skin="4">Delta file summary</AuHeading>
        </c.header>
        <c.content>
          <dl class="au-c-list-description">
            <dt class="au-u-bold">Deltas available</dt>
            <dd>{{this.totalDeltaFiles}}</dd>
            <dt class="au-u-bold">Delta range</dt>
            <dd>
              {{#if this.oldestDelta}}
                {{format-date this.oldestDelta "dd/MM/yyyy"}}
                –
                {{format-date this.newestDelta "dd/MM/yyyy"}}
              {{else}}
                —
              {{/if}}
            </dd>
            <dt class="au-u-bold">Latest full dataset</dt>
            <dd>
              {{#if this.latestFullDataset}}
                {{format-date this.latestFullDataset}}
              {{else}}
                —
              {{/if}}
            </dd>
          </dl>
        </c.content>
      </AuCard>
    </div>

    <AuCard as |c|>
      <c.header>
        <AuHeading @level="2" @skin="4">
          Scheduled jobs
          <AuHelpText @skin="tertiary">Sorted by time since last successful run</AuHelpText>
        </AuHeading>
      </c.header>
      <c.content class="au-u-padding-none">
        <table class="au-c-data-table">
          <thead>
            <tr>
              <th class="sortable {{if (eq this.sortColumn 'title') 'sorted'}}">
                <span class="au-c-data-table__header-title au-c-data-table__header-title--sortable {{if (eq this.sortColumn 'title') 'is-active'}}">
                  Title
                  <button class="au-c-data-table__sort" type="button" {{on "click" (fn this.sortBy "title")}}>
                    <AuIcon @icon={{if (eq this.sortColumn "title") (if (eq this.sortDir "asc") "nav-up" "nav-down") "nav-up-down"}} />
                  </button>
                </span>
              </th>
              <th class="sortable {{if (eq this.sortColumn 'lastRun') 'sorted'}}">
                <span class="au-c-data-table__header-title au-c-data-table__header-title--sortable {{if (eq this.sortColumn 'lastRun') 'is-active'}}">
                  Last run
                  <button class="au-c-data-table__sort" type="button" {{on "click" (fn this.sortBy "lastRun")}}>
                    <AuIcon @icon={{if (eq this.sortColumn "lastRun") (if (eq this.sortDir "asc") "nav-up" "nav-down") "nav-up-down"}} />
                  </button>
                </span>
              </th>
              <th class="sortable {{if (eq this.sortColumn 'nextRun') 'sorted'}}">
                <span class="au-c-data-table__header-title au-c-data-table__header-title--sortable {{if (eq this.sortColumn 'nextRun') 'is-active'}}">
                  Next run
                  <button class="au-c-data-table__sort" type="button" {{on "click" (fn this.sortBy "nextRun")}}>
                    <AuIcon @icon={{if (eq this.sortColumn "nextRun") (if (eq this.sortDir "asc") "nav-up" "nav-down") "nav-up-down"}} />
                  </button>
                </span>
              </th>
              <th>Schedule</th>
              <th>Deltas available</th>
              <th>Most recent delta</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.sortedJobs as |job|}}
              <tr>
                <td>
                  <AuLink
                    @route="overview.scheduled-jobs.details"
                    @model={{job.id}}>
                    {{job.title}}
                  </AuLink>
                </td>
                <td>
                  <AuPill
                    @skin={{job.stalenessStatus}}
                    title={{job.lastSuccessFormatted}}>
                    {{job.stalenessLabel}}
                  </AuPill>
                </td>
                <td>
                  {{#if job.nextRun}}
                    {{format-date job.nextRun "dd/MM/yyyy HH:mm"}}
                  {{else}}
                    —
                  {{/if}}
                </td>
                <td title={{job.schedule}}>
                  {{#if job.scheduleDescription}}
                    <span class="au-u-muted">{{job.scheduleDescription}}</span>
                  {{else}}
                    —
                  {{/if}}
                </td>
                <td>
                  {{job.deltaCountFormatted}}
                </td>
                <td>
                  {{#if job.latestDelta}}
                    {{format-date job.latestDelta "dd/MM/yyyy"}}
                  {{else}}
                    —
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </c.content>
    </AuCard>
  {{/if}}
</div>
