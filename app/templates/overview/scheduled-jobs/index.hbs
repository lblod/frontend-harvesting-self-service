{{page-title "Scheduled Jobs"}}

<AuDataTable
  @content={{this.model}}
  @noDataMessage="No scheduled jobs found"
  @sort={{this.sort}}
  @size={{this.size}}
  @page={{this.page}} as |t|>
  <t.menu as |menu|>
    <menu.general>
      <AuToolbar
        @border="none"
        @size="large"
        as |Group|>
        <Group>
          <AuHeading @level="1" @skin="1">Scheduled Jobs</AuHeading>
        </Group>
        <Group class="au-u-flex--vertical-center">
          <div class='au-u-max-width-xsmall au-u-flex au-u-flex--spaced-small'>
            <AuInput
              value={{this.search}}
              @queryParam='search'
              @label='Search'
              @labelHidden={{true}}
              @icon='search'
              @iconAlignment='right'
              @width='block'
              id='search'
              placeholder='Search title'
              oninput={{perform this.updateSearchQuery value='target.value'}}
            />
          </div>
          <AuLink
            @route="overview.scheduled-jobs.new"
            @skin="button"
            @icon="plus"
            @iconAlignment="left">
            Create new scheduled job
          </AuLink>
        </Group>
      </AuToolbar>
    </menu.general>
  </t.menu>
  <t.content class="{{if this.currentlyLoading "table-loading"}}" as |c|>
    <c.header>
      <AuDataTableThSortable
        @field="title"
        @currentSorting={{this.sort}}
        @label="Title"/>
      <th>Schedule</th>
      <AuDataTableThSortable
        @field="operation"
        @currentSorting={{this.sort}}
        @label="Operation"/>
      <AuDataTableThSortable
        @field="modified"
        @currentSorting={{this.sort}}
        @label="Modified"/>
      <AuDataTableThSortable
        @field="created"
        @currentSorting={{this.sort}}
        @label="Created"/>
      <th>Actions</th>
    </c.header>
    <c.body as |row|>
      <td>
        <AuLink
          @route="overview.scheduled-jobs.details"
          @model={{row.id}}>
          {{row.title}}
        </AuLink>
      </td>
      <td title={{row.schedule.repeatFrequency}}>
        {{#let (cron-description row.schedule.repeatFrequency) as |description|}}
          {{#if description}}
            {{description}}
          {{else}}
            —
          {{/if}}
        {{/let}}
      </td>
      <td class="au-u-word-break">
        {{operation-name row.operation}}
      </td>
      <td>
        {{format-date row.modified}}
      </td>
      <td>
        {{format-date row.created}}
      </td>
      <td>
        <AuLink
          @route="overview.scheduled-jobs.details"
          @skin="button"
          @icon="nav-right"
          @iconAlignment="right"
          @model={{row.id}}>
          View
        </AuLink>
      </td>
    </c.body>
  </t.content>
</AuDataTable>

{{outlet}}
