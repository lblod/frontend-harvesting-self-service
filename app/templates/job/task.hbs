{{page-title "Task details"}}

<AuMainContainer as |m|>
  <m.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content">
        <div class="au-u-padding au-u-padding-top">
          <AuLink
            @route="job.tasklist"
            @skin="button"
            @icon="nav-left"
            @iconAlignment="left"
            @width="inline"
            @model={{this.job.id}}
          >
            Back to tasklist
          </AuLink>
          {{!Task info}}
          <AuHeading
            @level="3"
            @skin="3"
            class="au-u-margin-top au-u-margin-bottom"
          >
            Task details
          </AuHeading>
          <dl class="au-u-flex--inline au-u-flex--wrap au-u-flex--spaced">
            <div>
              <dt class="au-u-bold">URI</dt>
              <dd>{{this.model.uri}}</dd>
            </div>
            <div>
              <dt class="au-u-bold">Operation</dt>
              <dd>{{this.model.operation}}</dd>
            </div>
            <div>
              <dt class="au-u-bold">Created</dt>
              <dd>{{format-date this.model.created}}</dd>
            </div>
            <div>
              <dt class="au-u-bold">Modified</dt>
              <dd>{{format-date this.model.modified}}</dd>
            </div>
            <div>
              <dt class="au-u-bold">Status</dt>
              <dd>
                <StatusPill @status={{this.model.shortStatus}} />
              </dd>
            </div>
            {{#if this.job.error.message}}
              <div>
                <dt class="au-u-hidden-visually">Errors</dt>
                <AuAlert @icon="cross" @title="Error" @skin="error">
                  <p>
                    <dd>{{this.job.error.message}}</dd>
                  </p>
                </AuAlert>
              </div>
            {{/if}}
          </dl>
          {{!End Task info}}
        </div>
      </div>
    </div>
  </m.sidebar>
  <m.content @scroll={{true}}>
    <div class="au-u-flex au-u-flex--column full-height">
      <AuTabs class="au-u-margin-top" as |Tab|>
        {{#unless
          (eq
            this.model.operation
            "http://lblod.data.gift/id/jobs/concept/TaskOperation/collecting"
          )
        }}
          {{#if (gt this.counts.inputContainerFiles 0)}}
            <Tab>
              <AuLink @route="job.task.input-container-files">
                Input Container Files ({{this.counts.inputContainerFiles}})
              </AuLink>
            </Tab>
          {{/if}}
        {{/unless}}
        {{#if (gt this.counts.resultContainerFiles 0)}}
          <Tab>
            <AuLink @route="job.task.results-container-files">
              Results Container Files ({{this.counts.resultContainerFiles}})
            </AuLink>
          </Tab>
        {{/if}}
        {{#unless
          (eq
            this.model.operation
            "http://lblod.data.gift/id/jobs/concept/TaskOperation/collecting"
          )
        }}
          {{#if (gt this.counts.inputContainerGraphs 0)}}
            <Tab>
              <AuLink @route="job.task.input-container-graph">
                Input Container Graph ({{this.counts.inputContainerGraphs}})
              </AuLink>
            </Tab>
          {{/if}}
          {{#if (gt this.counts.resultContainerGraphs 0)}}
            <Tab>
              <AuLink @route="job.task.results-container-graph">
                Results Container Graphs ({{this.counts.resultContainerGraphs}})
              </AuLink>
            </Tab>
          {{/if}}
        {{/unless}}
        {{#if (gt this.counts.inputContainerHarvestingCollections 0)}}
          <Tab>
            <AuLink @route="job.task.input-container-harvesting-collections">
              Input Container Harvesting Collections ({{this.counts.inputContainerHarvestingCollections}})
            </AuLink>
          </Tab>
        {{/if}}
        {{#if (gt this.counts.resultContainerHarvestingCollections 0)}}
          <Tab>
            <AuLink @route="job.task.results-container-harvesting-collections">
              Result Container Harvesting Collections ({{this.counts.resultContainerHarvestingCollections}})
            </AuLink>
          </Tab>
        {{/if}}
        {{#if (gt this.counts.inputResourceContainers 0)}}
          <Tab>
            <AuLink @route="job.task.input-container-resource">
              Input Containers with Resources ({{this.counts.inputResourceContainers}})
            </AuLink>
          </Tab>
        {{/if}}
        {{#if (gt this.counts.resultResourceContainers 0)}}
          <Tab>
            <AuLink @route="job.task.results-container-resource">
              Result Containers with Resources ({{this.counts.resultResourceContainers}})
            </AuLink>
          </Tab>
        {{/if}}
      </AuTabs>
      {{#if (eq 0 this.counts.total)}}
        <p>No inputs or results found.</p>
      {{else}}
        {{outlet}}
      {{/if}}
    </div>
  </m.content>
</AuMainContainer>